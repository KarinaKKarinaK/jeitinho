# Copy to .env. Every key here is from a free plan. None of them needs a card.

# Required for AI features. https://openrouter.ai/keys (set the key's credit limit to $0)
OPENROUTER_API_KEY=
# Optional. Comma-separated, max 4, tried in order. Anything that is not a free model is ignored.
OPENROUTER_MODELS=

# Optional: natural voice. https://elevenlabs.io
ELEVENLABS_API_KEY=
# Optional: a voice from your ElevenLabs "My Voices", and the model.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Optional: speaking practice and voice chat. https://console.deepgram.com
DEEPGRAM_API_KEY=

# Optional: the app asks for this passcode (Settings) before using AI or speech.
APP_PASSCODE=

# Optional: daily push reminders. Generate a P-256 key pair (public key as base64url raw point, private as base64url PKCS8).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: accounts and sync. The Vercel Supabase integration sets these for you.
SUPABASE_URL=
SUPABASE_ANON_KEY=
