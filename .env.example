# Free key from https://openrouter.ai/keys . Set its credit limit to $0 so it can never be charged.
OPENROUTER_API_KEY=
# Optional. Comma-separated, max 3. Anything that is not a free model is ignored.
OPENROUTER_MODELS=
# Optional. If set, the app asks for this passcode (Settings on the home screen) before using AI.
APP_PASSCODE=
